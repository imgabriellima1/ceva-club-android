<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/subscription"
        android:textAppearance="@style/Ceva.Heading" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/ceva_panel"
        android:layout_marginTop="16dp"
        android:padding="18dp">
        <TextView
            android:id="@+id/subscription_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textAppearance="@style/Ceva.Heading" />

        <TextView
            android:id="@+id/subscription_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/Ceva.Body" />

        <TextView
            android:id="@+id/subscription_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/Ceva.Body" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/view_plans"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="56dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancel_subscription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="56dp"
        style="@style/Widget.Material3.Button.TextButton"
        android:text="@string/cancel_subscription" />
</LinearLayout>
