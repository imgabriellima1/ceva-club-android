<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/profile"
        android:textAppearance="@style/Ceva.Heading" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/ceva_panel"
        android:layout_marginTop="16dp"
        android:padding="18dp">
        <TextView
            android:id="@+id/member_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textAppearance="@style/Ceva.Heading" />

        <TextView
            android:id="@+id/member_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/Ceva.Body" />
    </LinearLayout>

    <TextView
        android:id="@+id/profile_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textAppearance="@style/Ceva.Body" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/open_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="56dp"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:text="@string/view_result" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/open_quiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="56dp"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:text="@string/open_quiz" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/logout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="56dp"
        style="@style/Widget.Material3.Button.TextButton"
        android:text="@string/logout" />
</LinearLayout>
